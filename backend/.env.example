# OpenAI API 키를 여기에 입력하세요.
# https://platform.openai.com/api-keys 에서 발급받을 수 있습니다.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 사용할 Whisper 모델. 기본값 whisper-1 을 권장합니다.
# WHISPER_MODEL=whisper-1

# (선택) 포인트자막을 만들 때 사용할 텍스트 AI 모델. 기본값 gpt-4o
# (숫자/밀도 규칙을 정확히 지켜야 해서 gpt-4o-mini보다 정확도가 필요합니다).
# 비용을 더 아끼고 싶으면 gpt-4o-mini로 낮출 수 있습니다.
# TEXT_MODEL=gpt-4o
